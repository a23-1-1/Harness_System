# DB Demo Studio 后端配置
# 复制此文件为 .env 后修改

APP_ENV=development
DEBUG=true

# 服务端口
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dbdemo:dbdemo_pass@localhost:5432/db_demo_studio
PG_HOST=localhost
PG_PORT=5432
PG_USER=dbdemo
PG_PASSWORD=dbdemo_pass
PG_DATABASE=db_demo_studio

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM API
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=DEEPSEEK_API_KEY
LLM_PROVIDER=claude

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
