# ----------------------------------------
# PostgreSQL
# ----------------------------------------
PG_USER=dbdemo
PG_PASSWORD=dbdemo_pass
PG_DATABASE=db_demo_studio
PG_PORT=5432

# ----------------------------------------
# Redis
# ----------------------------------------
REDIS_PORT=6379

# ----------------------------------------
# 后端
# ----------------------------------------
BACKEND_PORT=8000
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ----------------------------------------
# PostgreSQL 连接 URL（Docker 内自动重写为服务名）
# 格式: postgresql+asyncpg://用户:密码@host:端口/数据库
DATABASE_URL=postgresql+asyncpg://dbdemo:dbdemo_pass@localhost:5432/db_demo_studio

# ----------------------------------------
# Redis 连接 URL
# 格式: redis://host:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------
# LLM API (SiliconFlow / DeepSeek)
# ----------------------------------------
LLM_PROVIDER=deepseek
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek 官方 provider 使用 deepseek-chat 或 deepseek-reasoner；SiliconFlow 可改用 deepseek-ai/DeepSeek-V3-0324
LLM_MODEL=deepseek-chat

# ----------------------------------------
# EXPLAIN 数据库引擎（本地开发用 localhost，Docker 内用 host.docker.internal）
# Windows/Mac 使用 host.docker.internal
# Linux 使用 172.17.0.1 或宿主机 IP
# ----------------------------------------
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3308
PG_EXPLAIN_HOST=host.docker.internal
PG_EXPLAIN_PORT=5433

# ----------------------------------------
# 前端构建变量
# ----------------------------------------
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8000/ws
FRONTEND_PORT=80

# ----------------------------------------
# WebSocket 配置
# ----------------------------------------
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# ----------------------------------------
# 日志
# ----------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
